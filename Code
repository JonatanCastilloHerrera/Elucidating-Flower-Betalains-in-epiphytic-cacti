classify_base_molecule <- function(name) {
  name_lower <- tolower(name)
  for (base in base_names_ordered) {
    if (grepl(base, name_lower, fixed = TRUE)) return(str_to_title(base))
  }
  return("Others")
}

# ==========================================
# STRUCTURAL FEATURES
# ==========================================
get_structural_features <- function(molecules) {
  lapply(molecules, function(m) {
    name_lower <- tolower(m)
    feats  <- c()
    
    # Every betalain shares the betalamic acid chromophore
    feats <- c(feats, "Betalamic Acid")
    
    is_betaxanthin <- grepl(
      "bx|xanthin|dopa|amine|arginine|lysine|glutamine|glutamic|asparagine|aspartic|
       threonine|serine|alanine|valine|isoleucine|leucine|methionine|phenylalanine|
       tyrosine|tryptophan|glycine|cysteine|proline|histamine|histidine|muscaaurin|spinacene|aminobutyric",
      name_lower
    )
    
    if (is_betaxanthin) {
      # Added: aminobutyric to catch GABA
      if (grepl("dopamine|tyramine|histamine|gaba|aminobutyric|l-dopa|dopaxanthin|miraxanthin iii|miraxanthin v", name_lower)) {
        feats <- c(feats, "Biogenic Amines (Dopamine, L-DOPA...)")
      } else if (grepl("phenylalanine|tyrosine|tryptophan|portulacaxanthin", name_lower)) {
        feats <- c(feats, "Aromatic AAs (Phe, Tyr, Trp)")
      } else if (grepl("arginine|lysine|histidine|glutamine|glutamic|asparagine|aspartic|threonine|serine|cysteine|vulgaxanthin|muscaaurin|miraxanthin ii", name_lower)) {
        feats <- c(feats, "Polar/Charged AAs (Glu, Arg, Ser...)")
      } else {
        feats <- c(feats, "Aliphatic AAs (Pro, Leu, Val...)")
      }
      
    } else {
      # --- Betacyanin core ---
      feats <- c(feats, "Cyclo-DOPA (Betacyanin Base)")
      
      if (!grepl("betanidin", name_lower)) {
        feats <- c(feats, "Glucose (1)")
        if (grepl("glabranin|bougainvillein", name_lower)) {
          feats <- c(feats, "Glucose (2)")
        }
        if (grepl("apiosyl|apiocactin", name_lower)) feats <- c(feats, "Apiose")
        if (grepl("rhamnosyl", name_lower))          feats <- c(feats, "Rhamnose")
        if (grepl("amaranthin|celosianin|iresinin|rivinianin", name_lower)) {
          feats <- c(feats, "Glucuronic Acid")
        }
      }
    }
    
    # --- Acyl / ester substituents ---
    if (grepl("biferuloyl", name_lower)) {
      feats <- c(feats, "Ferulic Acid (1)", "Ferulic Acid (2)")
    } else if (grepl("feruloyl|celosianin ii|gomphrenin[- ]iii", name_lower)) { # Added hyphen check
      feats <- c(feats, "Ferulic Acid (1)")
    }
    
    if (grepl("bicoum", name_lower)) {
      feats <- c(feats, "p-Coumaric Acid (1)", "p-Coumaric Acid (2)")
    } else if (grepl("coumaroyl|coumglabranin|celosianin i|gomphrenin[- ]iv", name_lower)) { # Added hyphen check
      feats <- c(feats, "p-Coumaric Acid (1)")
    }
    
    if (grepl("bimalonyl", name_lower)) {
      feats <- c(feats, "Malonic Acid (1)", "Malonic Acid (2)")
    } else if (grepl("malonyl|phyllocactin|lampranthin|gomphrenin[- ]ii", name_lower)) { # Added hyphen check
      feats <- c(feats, "Malonic Acid (1)")
    }
    
    if (grepl("hylocerenin", name_lower))  feats <- c(feats, "HMG Acid")
    if (grepl("sinapoyl",   name_lower))   feats <- c(feats, "Sinapic Acid")
    if (grepl("caffeoyl|cafglabranin", name_lower)) feats <- c(feats, "Caffeic Acid")
    if (grepl("sulfated|prebetanin|rivinianin", name_lower)) feats <- c(feats, "Sulfate Group")
    
    # --- Oxidative/reductive modifications ---
    # Added rule for tridecarboxylation
    if (grepl("tridecarboxy", name_lower)) {
      feats <- c(feats, "-CO2 (1)", "-CO2 (2)", "-CO2 (3)")
    } else if (grepl("bidecarboxy", name_lower)) {
      feats <- c(feats, "-CO2 (1)", "-CO2 (2)")
    } else if (grepl("decarboxy", name_lower)) {
      feats <- c(feats, "-CO2 (1)")
    }
    
    if (grepl("\\bdehydro\\b", name_lower) || grepl("\\bneobetanin\\b", name_lower)) {
      feats <- c(feats, "-H2 (Dehydrogenation)")
    }
    if (grepl("\\bneo\\b", name_lower) && !grepl("\\bneobetanin\\b", name_lower)) {
      feats <- c(feats, "C-15 Epimer")
    }
    
    if (length(feats) == 0) return(NULL)
    data.frame(Molecule_Clean = m, Feature = feats, stringsAsFactors = FALSE)
  }) %>%
    bind_rows() %>%
    mutate(Value = 1)
}

sort_phylogenetic_species <- function(sps) {
  ordered <- c()
  if (any(str_detect(tolower(sps), "macranthus")))    ordered <- c(ordered, sps[str_detect(tolower(sps), "macranthus")])
  if (any(str_detect(tolower(sps), "bud")))           ordered <- c(ordered, sps[str_detect(tolower(sps), "bud")])
  if (any(str_detect(tolower(sps), "eichlam")))       ordered <- c(ordered, sps[str_detect(tolower(sps), "eichlam")])
  if (any(str_detect(tolower(sps), "anthesis")))      ordered <- c(ordered, sps[str_detect(tolower(sps), "anthesis")])
  if (any(str_detect(tolower(sps), "flagelliformis")))ordered <- c(ordered, sps[str_detect(tolower(sps), "flagelliformis")])
  others <- setdiff(sps, ordered)
  return(c(ordered, others))
}

# --- MASTER FUNCTION: ANNOTATED SCATTER & STRUCTURAL HEATMAP ---
generate_annotated_heatmap <- function(df_heat, mol_order, species_order, mol_masses, marker_scale = 1.0) {
  p_main <- plot_ly()
  
  max_z <- max(df_heat$Z_Value, na.rm = TRUE)
  
  df_markers <- df_heat %>%
    filter(!is.na(Z_Value) & Z_Value > 0) %>%
    mutate(
      Molecule_Clean = factor(Molecule_Clean, levels = mol_order),
      Species        = factor(Species,        levels = species_order),
      Marker_Color   = case_when(
        grepl("cyan", tolower(Family)) ~ "rgba(236, 0, 140, 0.85)",
        grepl("xant", tolower(Family)) ~ "rgba(255, 242, 0, 0.85)",
        TRUE                           ~ "rgba(0, 174, 239, 0.85)"
      ),
      Marker_Size = if (max_z > 0) { 4 + (sqrt(Z_Value / max_z) * 26 * marker_scale) } else { 8 }
    )
  
  if (nrow(df_markers) > 0) {
    p_main <- p_main %>% add_trace(
      data = df_markers, x = ~Molecule_Clean, y = ~Species,
      type = "scatter", mode = "markers",
      marker = list(
        size      = ~Marker_Size,
        color     = ~Marker_Color,
        line      = list(color = "#17202A", width = 1.5),
        sizemode  = "diameter"
      ),
      hoverinfo = "text", text = ~Hover_Text, showlegend = FALSE
    )
  }
  
  p_main <- p_main %>%
    layout(
      xaxis = list(
        categoryorder = "array", categoryarray = mol_order,
        tickmode = "array", tickvals = mol_order, ticktext = mol_order,
        title = "", tickangle = -45,
        showline = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1.5,
        tickfont = list(family = "Arial", size = 11, color = "black"),
        showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1.5
      ),
      yaxis = list(
        categoryorder = "array", categoryarray = species_order, autorange = "reversed",
        title = "",
        showline = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1.5,
        tickfont = list(family = "Arial", size = 11, color = "black"),
        showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1.5
      ),
      plot_bgcolor = "#ffffff", paper_bgcolor = "#ffffff"
    )
  
  all_feat_levels <- c(
    "Betalamic Acid",
    "Cyclo-DOPA (Betacyanin Base)",
    "Biogenic Amines (Dopamine, L-DOPA...)",
    "Aromatic AAs (Phe, Tyr, Trp)",
    "Polar/Charged AAs (Glu, Arg, Ser...)",
    "Aliphatic AAs (Pro, Leu, Val...)",
    "Glucose (1)", "Glucose (2)", "Apiose", "Rhamnose", "Glucuronic Acid",
    "Malonic Acid (1)", "Malonic Acid (2)", "HMG Acid",
    "Ferulic Acid (1)", "Ferulic Acid (2)",
    "p-Coumaric Acid (1)", "p-Coumaric Acid (2)",
    "Sinapic Acid", "Caffeic Acid",
    "Sulfate Group",
    "-CO2 (1)", "-CO2 (2)", "-CO2 (3)",   # Added tridecarboxylation
    "-H2 (Dehydrogenation)",
    "C-15 Epimer"
  )
  
  struct_df <- get_structural_features(mol_order)
  
  if (is.null(struct_df) || nrow(struct_df) == 0) {
    present_features <- "Betalamic Acid"
    struct_df <- data.frame(Molecule_Clean = mol_order, Feature = "Betalamic Acid", Value = 0)
  } else {
    present_features <- intersect(all_feat_levels, unique(struct_df$Feature))
  }
  
  struct_df$Feature <- factor(struct_df$Feature, levels = present_features)
  struct_df <- struct_df %>%
    complete(
      Molecule_Clean = factor(mol_order, levels = mol_order),
      Feature        = factor(present_features, levels = present_features),
      fill           = list(Value = 0)
    )
  
  p_struct <- plot_ly() %>% add_heatmap(
    data       = struct_df, x = ~Molecule_Clean, y = ~Feature, z = ~Value,
    colorscale = list(c(0, "#F4F6F6"), c(1, "#154360")),
    zmin = 0, zmax = 1, showscale = FALSE,
    xgap = 2, ygap = 2,
    hoverinfo = "text",
    text = ~paste("<b>", Molecule_Clean, "</b><br>Block:", Feature)
  )
  
  mass_labels    <- sapply(mol_masses, function(m) if (is.na(m)) "-" else as.character(round(m, 1)))
  combined_labels <- paste0(mass_labels, " - ", mol_order)
  
  subplot(p_main, p_struct, nrows = 2, shareX = FALSE, heights = c(0.45, 0.55), margin = 0.12) %>%
    layout(
      plot_bgcolor = "#ffffff", paper_bgcolor = "#ffffff",
      margin = list(b = 220, l = 220, t = 40, r = 60),
      xaxis2 = list(
        categoryorder = "array", categoryarray = mol_order, matches = "x",
        tickmode = "array", tickvals = mol_order, ticktext = combined_labels,
        title = "", tickangle = -60,
        showline = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1.5,
        tickfont = list(family = "Arial", size = 10, color = "black"),
        showgrid = TRUE, gridcolor = "#E5E8E8"
      ),
      yaxis2 = list(
        title = "", categoryorder = "array", categoryarray = present_features,
        autorange = "reversed",
        tickfont  = list(family = "Arial", size = 10, color = "black"),
        showline  = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1.5
      )
    ) %>%
    config(displayModeBar = TRUE)
}


server <- function(input, output, session) {
  
  raw_data <- reactive({
    files <- list.files(PATH_FOLDER, pattern = "\\.csv$", full.names = TRUE)
    if (length(files) == 0) return(NULL)
    files <- files[!basename(files) %in% c("Af.csv", "Disocactus_speciosus.csv")]
    
    list_exp <- lapply(files, function(f) {
      tryCatch({
        df <- read_csv(f, col_types = cols(.default = "c"), show_col_types = FALSE)
        if (ncol(df) < 10) return(NULL)
        # Translated column names to English
        colnames(df)[1:10] <- c("Peak", "Start", "RT", "End", "Height", "Area", "Pct_Area", "mz", "z", "Abundance")
        df$species_name <- basename(f) %>%
          str_remove("\\.csv$") %>% str_replace_all("_", " ")
        df %>%
          mutate(across(c(mz, Area, RT), ~as.numeric(str_remove_all(., ",")))) %>%
          drop_na(mz, Area)
      }, error = function(e) return(NULL))
    })
    
    if (!file.exists(PATH_TEO)) return(NULL)
    teo_raw <- read_excel(PATH_TEO, sheet = 1, col_types = "text")
    colnames(teo_raw)[1:2] <- c("group", "molecule")
    teo_raw$char_frag <- teo_raw[[3]]
    
    teo <- teo_raw %>%
      pivot_longer(cols = -c(group, molecule, char_frag),
                   names_to = "frag", values_to = "mz_teo") %>%
      mutate(mz_teo    = as.numeric(mz_teo),
             char_frag = as.numeric(char_frag)) %>%
      drop_na(mz_teo)
    
    output$statusMessage <- renderText("System Online")
    list(exp = bind_rows(list_exp), teo = teo)
  })
  
  observe({
    d <- raw_data()
    if (!is.null(d)) {
      ordered_sp <- sort_phylogenetic_species(unique(d$exp$species_name))
      updateCheckboxGroupInput(session, "selected_species",
                               choices = ordered_sp, selected = ordered_sp)
      updateCheckboxGroupInput(session, "selected_groups",
                               choices = unique(d$teo$group), selected = unique(d$teo$group))
    }
  })
  
  processed_data <- reactive({
    req(input$selected_species, input$selected_groups)
    d <- raw_data()
    if (is.null(d)) return(data.frame())
    
    exp_sub <- d$exp %>%
      filter(species_name %in% input$selected_species, Area >= input$min_area)
    teo_sub <- d$teo %>%
      filter(group %in% input$selected_groups)
    
    fw_table <- tribble(
      ~pattern,          ~weight,
      "macranthus",      27.5,
      "bud",              7.53,
      "eichlam",         11.9,
      "speciosus",       48.0,
      "flagelliformis",  12.2
    )
    
    get_weight <- function(sp_name) {
      sp_lower <- tolower(sp_name)
      for (i in seq_len(nrow(fw_table))) {
        if (grepl(fw_table$pattern[i], sp_lower, fixed = TRUE)) return(fw_table$weight[i])
      }
      return(1)
    }
    
    matches <- vector("list", nrow(exp_sub))
    for (i in seq_len(nrow(exp_sub))) {
      err <- abs(teo_sub$mz_teo - exp_sub$mz[i]) / teo_sub$mz_teo * 1e6
      if (min(err, na.rm = TRUE) <= input$tolerance) {
        hit    <- which.min(err)
        sp_name <- exp_sub$species_name[i]
        weight  <- get_weight(sp_name)
        
        char_frag_val <- teo_sub$char_frag[hit]
        
        is_char <- !is.na(char_frag_val) &&
          (abs(teo_sub$mz_teo[hit] - char_frag_val) / char_frag_val * 1e6 <= 10)
        
        matches[[i]] <- data.frame(
          Species      = sp_name,
          Raw_Area     = exp_sub$Area[i],
          Weight_g     = weight,
          Area         = exp_sub$Area[i] / weight,
          Molecule     = teo_sub$molecule[hit],
          Family       = teo_sub$group[hit],
          Base         = classify_base_molecule(teo_sub$molecule[hit]),
          Mass         = if (!is.na(char_frag_val)) char_frag_val else teo_sub$mz_teo[hit],
          RT           = exp_sub$RT[i],
          Exp_mz       = exp_sub$mz[i],
          Teo_mz       = teo_sub$mz_teo[hit],
          Frag_Type    = teo_sub$frag[hit],
          Error_PPM    = min(err, na.rm = TRUE),
          Is_Char_Frag = is_char
        )
      }
    }
    
    matches <- Filter(Negate(is.null), matches)
    if (length(matches) == 0) return(data.frame())
    
    bind_rows(matches) %>%
      distinct() %>%
      mutate(Molecule_Clean = clean_chem_names(Molecule))
  })
  
  observe({
    df <- processed_data()
    if (!is.null(df) && nrow(df) > 0) {
      mol_choices <- sort(unique(df$Molecule_Clean))
      updateCheckboxGroupInput(session, "selected_molecules",
                               choices = mol_choices, selected = mol_choices)
      
      sp_choices   <- sort_phylogenetic_species(unique(df$Species))
      selected_mol <- if ("Phyllocactin" %in% mol_choices) "Phyllocactin" else mol_choices[1]
      if (!is.null(input$ref_molecule) && input$ref_molecule %in% mol_choices)
        selected_mol <- input$ref_molecule
      
      selected_sp <- sp_choices[1]
      anthesis_match <- sp_choices[str_detect(tolower(sp_choices), "anthesis")]
      if (length(anthesis_match) > 0) selected_sp <- anthesis_match[1]
      if (!is.null(input$ref_species) && input$ref_species %in% sp_choices)
        selected_sp <- input$ref_species
      
      updateSelectInput(session, "ref_molecule", choices = mol_choices, selected = selected_mol)
      updateSelectInput(session, "ref_species",  choices = sp_choices,  selected = selected_sp)
    }
  })
  
  observeEvent(input$sel_all_mols, {
    df <- processed_data(); req(df)
    updateCheckboxGroupInput(session, "selected_molecules",
                             selected = sort(unique(df$Molecule_Clean)))
  })
  observeEvent(input$desel_all_mols, {
    updateCheckboxGroupInput(session, "selected_molecules", selected = character(0))
  })
  observeEvent(input$select_all_sp, {
    d <- raw_data(); req(d)
    updateCheckboxGroupInput(session, "selected_species",
                             selected = sort_phylogenetic_species(unique(d$exp$species_name)))
  })
  observeEvent(input$deselect_all_sp, {
    updateCheckboxGroupInput(session, "selected_species", selected = character(0))
  })
  
  get_base_df <- reactive({
    df <- processed_data()
    req(nrow(df) > 0, input$selected_molecules)
    
    df <- df %>% filter(Molecule_Clean %in% input$selected_molecules)
    
    if (input$collapse_vars) {
      df %>%
        mutate(Molecule_Clean = Base) %>%
        group_by(Molecule_Clean, Family, Species, Base) %>%
        summarise(A = sum(Area, na.rm = TRUE),
                  Mass = mean(Mass, na.rm = TRUE), .groups = "drop")
    } else {
      df %>%
        group_by(Molecule_Clean, Family, Species, Base) %>%
        arrange(desc(Is_Char_Frag), desc(Area)) %>%
        slice(1) %>%
        summarise(A = first(Area), Mass = first(Mass), .groups = "drop")
    }
  })
  
  get_safe_masses <- function(df_heat, mol_order) {
    sapply(mol_order, function(m) {
      val <- df_heat$Mass[df_heat$Molecule_Clean == m]
      if (length(val) > 0 && !all(is.na(val))) val[1] else NA
    })
  }
  
  # --- Panels 1, 2, 3 (bubble heatmaps) ---
  output$heatmapMassContainer <- renderUI({
    h <- max(950, 500 + length(input$selected_species) * 50)
    plotlyOutput("heatmapMassPlot", height = paste0(h, "px"))
  })
  output$heatmapMassPlot <- renderPlotly({
    df_base <- get_base_df(); req(df_base)
    df_heat <- df_base %>%
      group_by(Species) %>%
      mutate(Real_Value = (A / max(A, na.rm = TRUE)) * 100,
             Z_Value    = log10(Real_Value + 1)) %>%
      ungroup() %>%
      arrange(Mass, Molecule_Clean) %>%
      mutate(Hover_Text = paste("<b>", Molecule_Clean, "</b><br>Sp:", Species,
                                "<br>Relative Area (%):", round(Real_Value, 2)))
    mol_order     <- unique(df_heat$Molecule_Clean)
    species_order <- sort_phylogenetic_species(unique(df_heat$Species))
    mol_masses    <- get_safe_masses(df_heat, mol_order)
    generate_annotated_heatmap(df_heat, mol_order, species_order, mol_masses,
                               marker_scale = input$marker_visual_scale)
  })
  
  output$heatmapRawContainer <- renderUI({
    h <- max(950, 500 + length(input$selected_species) * 50)
    plotlyOutput("heatmapRawPlot", height = paste0(h, "px"))
  })
  output$heatmapRawPlot <- renderPlotly({
    df_base <- get_base_df(); req(df_base)
    df_heat <- df_base %>%
      mutate(Real_Value = A, Z_Value = log10(A)) %>%
      arrange(Mass, Molecule_Clean) %>%
      mutate(Hover_Text = paste("<b>", Molecule_Clean, "</b><br>Sp:", Species,
                                "<br>Area/g FW:", format(Real_Value, scientific = TRUE, digits = 3)))
    mol_order     <- unique(df_heat$Molecule_Clean)
    species_order <- sort_phylogenetic_species(unique(df_heat$Species))
    mol_masses    <- get_safe_masses(df_heat, mol_order)
    generate_annotated_heatmap(df_heat, mol_order, species_order, mol_masses,
                               marker_scale = input$marker_visual_scale)
  })
  
  output$heatmapPhylloContainer <- renderUI({
    h <- max(950, 500 + length(input$selected_species) * 50)
    plotlyOutput("heatmapPhylloPlot", height = paste0(h, "px"))
  })
  output$heatmapPhylloPlot <- renderPlotly({
    df_base <- get_base_df()
    req(df_base, input$ref_molecule, input$ref_species, input$rel_scale_type)
    ref_row  <- df_base %>%
      filter(Molecule_Clean == input$ref_molecule, Species == input$ref_species)
    ref_area <- if (nrow(ref_row) > 0) max(ref_row$A, na.rm = TRUE) else max(df_base$A, na.rm = TRUE)
    df_heat <- df_base %>%
      mutate(
        Real_Value  = (A / ref_area) * 100,
        Z_Value     = if (input$rel_scale_type == "Logarithmic") log10(Real_Value + 1) else Real_Value,
        Family_Sort = case_when(
          grepl("xant", tolower(Family)) ~ 1,
          grepl("cyan", tolower(Family)) ~ 2,
          TRUE ~ 3
        )
      ) %>%
      arrange(Family_Sort, Mass, Molecule_Clean) %>%
      mutate(Hover_Text = paste("<b>", Molecule_Clean, "</b><br>Sp:", Species,
                                "<br>Rel. to", input$ref_molecule,
                                "(%):", round(Real_Value, 2)))
    mol_order     <- unique(df_heat$Molecule_Clean)
    species_order <- sort_phylogenetic_species(unique(df_heat$Species))
    mol_masses    <- get_safe_masses(df_heat, mol_order)
    generate_annotated_heatmap(df_heat, mol_order, species_order, mol_masses,
                               marker_scale = input$marker_visual_scale)
  })
  
  # --- Panel 4: Identification Table ---
  output$id_table <- renderDT({
    df <- processed_data()
    req(nrow(df) > 0)
    df <- df %>% filter(Molecule_Clean %in% input$selected_molecules)
    table_out <- df %>%
      select(Species, Family, Molecule_Clean, RT,
             Exp_mz, Teo_mz, Frag_Type, Is_Char_Frag, Error_PPM, Raw_Area, Area) %>%
      rename(
        `Species / Stage`        = Species,
        `Chemical Family`        = Family,
        `Identified Betalain`    = Molecule_Clean,
        `Retention Time (min)`   = RT,
        `Experimental m/z`       = Exp_mz,
        `Theoretical m/z`        = Teo_mz,
        `Matched Fragment`       = Frag_Type,
        `Char. Fragment?`        = Is_Char_Frag,
        `Error (PPM)`            = Error_PPM,
        `Raw Peak Area`          = Raw_Area,
        `Normalized Area (per g)`= Area
      ) %>%
      arrange(`Species / Stage`, `Retention Time (min)`)
    datatable(table_out,
              options  = list(pageLength = 15, scrollX = TRUE),
              rownames = FALSE,
              class    = "cell-border stripe") %>%
      formatRound(columns = c("Experimental m/z", "Theoretical m/z"), digits = 4) %>%
      formatRound(columns = c("Retention Time (min)", "Error (PPM)"), digits = 2) %>%
      formatSignif(columns = c("Raw Peak Area", "Normalized Area (per g)"), digits = 4)
  })
  
  # --- Panel 5: Family bubbles ---
  output$heatmapFamilyContainer <- renderUI({
    h <- max(500, 300 + length(input$selected_species) * 50)
    plotlyOutput("heatmapFamilyPlot", height = paste0(h, "px"))
  })
  output$heatmapFamilyPlot <- renderPlotly({
    df_base <- get_base_df(); req(df_base)
    df_mols <- df_base %>%
      arrange(desc(A)) %>%
      mutate(
        Z_Value      = log10(A + 1),
        Marker_Color = case_when(
          grepl("cyan", tolower(Family)) ~ "rgba(236, 0, 140, 0.5)",
          grepl("xant", tolower(Family)) ~ "rgba(255, 242, 0, 0.5)",
          TRUE                           ~ "rgba(0, 174, 239, 0.5)"
        ),
        Hover_Text = paste("<b>", Molecule_Clean, "</b><br>Family:", Family,
                           "<br>Sp:", Species,
                           "<br>Area/g:", format(A, scientific = TRUE, digits = 3))
      )
    max_z   <- max(df_mols$Z_Value, na.rm = TRUE)
    df_mols <- df_mols %>%
      mutate(Marker_Size = if (max_z > 0) 6 + (sqrt(Z_Value / max_z) * 55 * input$marker_visual_scale) else 12)
    
    species_order <- sort_phylogenetic_species(unique(df_mols$Species))
    family_order  <- sort(unique(df_mols$Family))
    
    plot_ly(
      data = df_mols,
      x = ~factor(Family,  levels = family_order),
      y = ~factor(Species, levels = species_order),
      type = "scatter", mode = "markers",
      marker = list(size = ~Marker_Size, color = ~Marker_Color,
                    line = list(color = "rgba(23,32,42,0.8)", width = 1),
                    sizemode = "diameter"),
      hoverinfo = "text", text = ~Hover_Text, showlegend = FALSE
    ) %>%
      layout(
        xaxis = list(title = "", showline = TRUE, mirror = TRUE, linecolor = "black",
                     linewidth = 1.5, tickfont = list(family = "Arial", size = 12, color = "black"),
                     showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1.5),
        yaxis = list(autorange = "reversed", title = "", showline = TRUE, mirror = TRUE,
                     linecolor = "black", linewidth = 1.5,
                     tickfont = list(family = "Arial", size = 11, color = "black"),
                     showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1.5),
        plot_bgcolor = "#ffffff", paper_bgcolor = "#ffffff",
        margin = list(l = 220, b = 80, t = 40, r = 60)
      ) %>% config(displayModeBar = TRUE)
  })
  
  # --- Panel 6: Stacked bars (absolute) ---
  output$barplotFamilyContainer <- renderUI({
    h <- max(500, 300 + length(input$selected_species) * 50)
    plotlyOutput("barplotFamily", height = paste0(h, "px"))
  })
  output$barplotFamily <- renderPlotly({
    df_base <- get_base_df(); req(df_base)
    df_summary <- df_base %>%
      group_by(Species, Family) %>%
      summarise(Total_A = sum(A, na.rm = TRUE), .groups = "drop") %>%
      group_by(Species) %>%
      mutate(
        Total_Species = sum(Total_A, na.rm = TRUE),
        Pct           = (Total_A / Total_Species) * 100,
        Family_Group  = case_when(
          grepl("cyan", tolower(Family)) ~ "Betacyanins",
          grepl("xant", tolower(Family)) ~ "Betaxanthins",
          TRUE                           ~ "Others / Precursors"
        )
      ) %>% ungroup()
    species_order <- sort_phylogenetic_species(unique(df_summary$Species))
    plot_ly(
      data = df_summary,
      y = ~factor(Species, levels = species_order), x = ~Total_A,
      color = ~Family_Group,
      colors = c("Betacyanins"       = "#EC008C",
                 "Betaxanthins"      = "#FFF200",
                 "Others / Precursors" = "#00AEEF"),
      type = "bar", orientation = "h",
      text = ~paste0(round(Pct, 1), "%"), textposition = "auto",
      hoverinfo = "text",
      hovertext = ~paste("<b>", Family_Group, "</b><br>Sp:", Species,
                         "<br>Total Area/g:", format(Total_A, scientific = TRUE, digits = 3),
                         "<br>Proportion:", round(Pct, 2), "%"),
      marker = list(line = list(color = "#17202A", width = 1.2))
    ) %>%
      layout(
        barmode = "stack",
        xaxis = list(title = "Total Normalized Area (Area / g FW)",
                     showline = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1.5,
                     tickfont = list(family = "Arial", size = 12, color = "black"),
                     showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1.5),
        yaxis = list(autorange = "reversed", title = "", showline = TRUE, mirror = TRUE,
                     linecolor = "black", linewidth = 1.5,
                     tickfont = list(family = "Arial", size = 11, color = "black")),
        plot_bgcolor = "#ffffff", paper_bgcolor = "#ffffff",
        margin = list(l = 220, b = 80, t = 40, r = 60),
        legend = list(orientation = "h", xanchor = "center", x = 0.5, y = 1.05)
      ) %>% config(displayModeBar = TRUE)
  })
  
  # --- Panel 7: 100% stacked bars ---
  output$barplotPercentContainer <- renderUI({
    h <- max(500, 300 + length(input$selected_species) * 50)
    plotlyOutput("barplotPercent", height = paste0(h, "px"))
  })
  
  output$barplotPercent <- renderPlotly({
    df_base <- get_base_df(); req(df_base)
    df_summary <- df_base %>%
      group_by(Species, Family) %>%
      summarise(Total_A = sum(A, na.rm = TRUE), .groups = "drop") %>%
      group_by(Species) %>%
      mutate(
        Total_Species = sum(Total_A, na.rm = TRUE),
        Pct           = (Total_A / Total_Species) * 100,
        Family_Group  = case_when(
          grepl("cyan", tolower(Family)) ~ "Betacyanins",
          grepl("xant", tolower(Family)) ~ "Betaxanthins",
          TRUE                           ~ "Others / Precursors"
        )
      ) %>% ungroup()
    
    species_order <- sort_phylogenetic_species(unique(df_summary$Species))
    
    plot_ly(
      data = df_summary,
      y = ~factor(Species, levels = species_order), x = ~Pct,
      color = ~Family_Group,
      colors = c("Betacyanins"       = "#EC008C",
                 "Betaxanthins"      = "#FFF200",
                 "Others / Precursors" = "#00AEEF"),
      type = "bar", orientation = "h",
      text = ~paste0(round(Pct, 1), "%"), textposition = "auto",
      hoverinfo = "text",
      hovertext = ~paste("<b>", Family_Group, "</b><br>Sp:", Species,
                         "<br>Proportion:", round(Pct, 2), "%",
                         "<br>Absolute Area:", format(Total_A, scientific = TRUE, digits = 3)),
      marker = list(line = list(color = "#17202A", width = 1.2))
    ) %>%
      layout(
        font = list(family = "Arial", size = 11, color = "black"), 
        barmode = "stack",
        xaxis = list(
          title = list(text = "Relative Proportion (%)", font = list(size = 11)),
          showline = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1.5,
          tickfont = list(family = "Arial", size = 11, color = "black"),
          showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1.5,
          range = c(0, 100)
        ),
        yaxis = list(
          autorange = "reversed", title = "", showline = TRUE, mirror = TRUE,
          linecolor = "black", linewidth = 1.5,
          tickfont = list(family = "Arial", size = 11, color = "black")
        ),
        plot_bgcolor = "#ffffff", paper_bgcolor = "#ffffff",
        margin = list(l = 220, b = 80, t = 40, r = 60),
        legend = list(
          orientation = "h", xanchor = "center", x = 0.5, y = 1.05,
          font = list(family = "Arial", size = 11, color = "black")
        )
      ) %>% 
      config(
        displayModeBar = TRUE,
        toImageButtonOptions = list(
          format = "svg",
          filename = "Relative_Proportions_100Pct"
        )
      )
  })
  
  # --- Export ---
  output$downloadData <- downloadHandler(
    filename = function() paste0("betalains_analysis_", Sys.Date(), ".xlsx"),
    content  = function(file) write_xlsx(processed_data(), path = file)
  )
}

shinyApp(ui, server)

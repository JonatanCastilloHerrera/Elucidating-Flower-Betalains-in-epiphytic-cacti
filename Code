# FIX #6 (Updated): Cleaning "-betaxanthin" and "-bx" suffixes
clean_chem_names <- function(names) {
  names %>%
    str_remove_all("\\s*\\([^)]*\\)") %>%
    str_replace_all("(?i)\\bdecarboxy\\b", "Decarboxy") %>%
    str_replace_all("(?i)\\bdehydro\\b",   "Dehydro")   %>%
    str_replace_all("(?i)\\biso\\b",        "Iso")        %>%
    str_replace_all("(?i)\\bneo\\b",        "Neo")        %>%
    str_replace_all("(?i)\\bbidecarboxy\\b","Bidecarboxy") %>%
    str_replace_all("(?i)-betaxanthin$", "") %>%  # Removes full word
    str_replace_all("-bx$",   "")   %>%
    str_replace_all(" acid",  "")   %>%
    str_replace_all("_",      " ")  %>%
    str_trim()                      %>%
    str_to_title()
}


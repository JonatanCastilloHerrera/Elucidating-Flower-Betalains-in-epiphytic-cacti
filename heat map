collapse_name <- function(names, groups) {
  res <- names
  pos_pat <- "(?i)([0-9,]+[']?(?:-[A-Za-z]+)?[-_\\s]*)?"
  
  if ("Isomerization (Iso-)" %in% groups) {
    is_iso_aa <- grepl("(?i)isoleucine", res) 
    res[!is_iso_aa] <- str_replace_all(res[!is_iso_aa], paste0(pos_pat, "\\bIso[-_\\s]*"), "")
  }
  if ("Epimerization (Neo-)" %in% groups) {
    res <- str_replace_all(res, paste0(pos_pat, "\\bNeo[-_\\s]*"), "")
  }
  if ("Decarboxylation (-CO2)" %in% groups) {
    res <- str_replace_all(res, paste0(pos_pat, "(tri|bi)?decarboxy[-_\\s]*"), "")
  }
  if ("Dehydrogenation (-H2)" %in% groups) {
    res <- str_replace_all(res, paste0(pos_pat, "dehydro(?:genated)?[-_\\s]*"), "")
  }
  if ("Acylation (Malonyl, etc.)" %in% groups) {
    res <- str_replace_all(res, "(?i).*\\bPhyllocactin\\b.*", "Betanin")
    res <- str_replace_all(res, "(?i).*\\bHylocerenin\\b.*", "Betanin")
    res <- str_replace_all(res, "(?i).*\\bMammillarinin\\b.*", "Betanin")
    res <- str_replace_all(res, "(?i).*\\bLampranthin\\b.*", "Betanin")
    res <- str_replace_all(res, "(?i).*\\bRivinianin\\b.*", "Betanin")
    res <- str_replace_all(res, "(?i).*\\bGlabranin\\b.*", "Betanin")
    res <- str_replace_all(res, "(?i).*\\bCelosianin.*", "Amaranthin")
    res <- str_replace_all(res, "(?i).*\\bGomphrenin[-_\\s]*(II|III|IV)\\b.*", "Gomphrenin") 
    
    res <- str_replace_all(res, paste0(pos_pat, "(tri|bi)?malonyl[-_\\s]*"), "")
    res <- str_replace_all(res, paste0(pos_pat, "(tri|bi)?feruloyl[-_\\s]*"), "")
    res <- str_replace_all(res, paste0(pos_pat, "(tri|bi)?coumaroyl[-_\\s]*"), "")
    res <- str_replace_all(res, paste0(pos_pat, "(tri|bi)?sinapoyl[-_\\s]*"), "")
    res <- str_replace_all(res, paste0(pos_pat, "(tri|bi)?caffeoyl[-_\\s]*"), "")
  }
  if ("Glycosylation (Glc, Api, etc.)" %in% groups) {
    res <- str_replace_all(res, "(?i).*\\bApiocactin\\b.*", "Betanidin")
    res <- str_replace_all(res, "(?i).*\\bAmaranthin\\b.*", "Betanidin")
    res <- str_replace_all(res, "(?i).*\\bBougainvillein\\b.*", "Betanidin")
    res <- str_replace_all(res, "(?i).*\\bGomphrenin.*", "Betanidin")
    res <- str_replace_all(res, "(?i).*\\bBetanin\\b.*", "Betanidin")
    res <- str_replace_all(res, "(?i).*\\bMelocactin\\b.*", "Betanidin")
    res <- str_replace_all(res, "(?i).*\\bIresinin\\b.*", "Betanidin")
  }
  
  res <- str_replace_all(res, "[-_]{2,}", "-")
  res <- str_replace_all(res, "^[-_\\s]+|[-_\\s]+$", "")
  res <- str_trim(res)
  res <- str_to_title(res)
  return(res)
}

# ==========================================
# STRUCTURAL FEATURES
# ==========================================
get_structural_features <- function(molecules) {
  lapply(molecules, function(m) {
    nombre <- tolower(m)
    feats  <- c()
    
    feats <- c(feats, "Betalamic Acid")
    
    is_betaxanthin <- grepl(
      "bx|xanthin|dopa|amine|arginine|lysine|glutamine|glutamic|asparagine|aspartic|threonine|serine|alanine|valine|isoleucine|leucine|methionine|phenylalanine|tyrosine|tryptophan|glycine|cysteine|proline|histamine|histidine|muscaaurin|spinacene|aminobutyric",
      nombre
    )
    
    if (is_betaxanthin) {
      if (grepl("dopamine|tyramine|histamine|gaba|aminobutyric|l-dopa|dopaxanthin|miraxanthin iii|miraxanthin v", nombre)) {
        feats <- c(feats, "Biogenic Amines")
      } else if (grepl("phenylalanine|tyrosine|tryptophan|portulacaxanthin", nombre)) {
        feats <- c(feats, "Aromatic AAs")
      } else if (grepl("arginine|lysine|histidine|glutamine|glutamic|asparagine|aspartic|threonine|serine|cysteine|vulgaxanthin|muscaaurin|miraxanthin ii", nombre)) {
        feats <- c(feats, "Polar/Charged AAs")
      } else {
        feats <- c(feats, "Aliphatic AAs")
      }
    } else {
      feats <- c(feats, "Cyclo-DOPA")
      if (!grepl("betanidin", nombre)) {
        feats <- c(feats, "Glucose (1)")
        if (grepl("glabranin|bougainvillein|mammillarinin|melocactin", nombre)) {
          feats <- c(feats, "Glucose (2)")
        }
        if (grepl("apiosyl|apiocactin", nombre)) feats <- c(feats, "Apiose")
        if (grepl("rhamnosyl", nombre))          feats <- c(feats, "Rhamnose")
        if (grepl("amaranthin|celosianin|iresinin|rivinianin", nombre)) {
          feats <- c(feats, "Glucuronic Acid")
        }
      }
    }
    
    if (grepl("biferuloyl", nombre)) {
      feats <- c(feats, "Ferulic Acid (1)", "Ferulic Acid (2)")
    } else if (grepl("feruloyl|celosianin[-_ ]?ii\\b|gomphrenin[-_ ]?iii\\b|lampranthin[-_ ]?ii\\b", nombre)) { 
      feats <- c(feats, "Ferulic Acid (1)")
    }
    
    if (grepl("bicoum", nombre)) {
      feats <- c(feats, "p-Coumaric Acid (1)", "p-Coumaric Acid (2)")
    } else if (grepl("coumaroyl|coumglabranin|celosianin[-_ ]?i\\b", nombre) || 
               (grepl("lampranthin", nombre) && !grepl("lampranthin[-_ ]?ii\\b", nombre))) { 
      feats <- c(feats, "p-Coumaric Acid (1)")
    }
    
    if (grepl("bimalonyl", nombre)) {
      feats <- c(feats, "Malonic Acid (1)", "Malonic Acid (2)")
    } else if (grepl("malonyl|phyllocactin|gomphrenin[-_ ]?ii\\b|mammillarinin", nombre)) { 
      feats <- c(feats, "Malonic Acid (1)")
    }
    
    if (grepl("hylocerenin", nombre))  feats <- c(feats, "HMG Acid")
    if (grepl("sinapoyl|gomphrenin[-_ ]?iv\\b", nombre)) feats <- c(feats, "Sinapic Acid") 
    if (grepl("caffeoyl|cafglabranin", nombre)) feats <- c(feats, "Caffeic Acid")
    if (grepl("sulfated|prebetanin|rivinianin", nombre)) feats <- c(feats, "Sulfate Group")
    
    if (grepl("tridecarboxy", nombre)) {
      feats <- c(feats, "-CO2 (1)", "-CO2 (2)", "-CO2 (3)")
    } else if (grepl("bidecarboxy", nombre)) {
      feats <- c(feats, "-CO2 (1)", "-CO2 (2)")
    } else if (grepl("decarboxy", nombre)) {
      feats <- c(feats, "-CO2 (1)")
    }
    
    if (grepl("\\bdehydro\\b", nombre) || grepl("\\bneobetanin\\b", nombre)) {
      feats <- c(feats, "-H2")
    }
    if (grepl("\\bneo\\b", nombre) && !grepl("\\bneobetanin\\b", nombre)) {
      feats <- c(feats, "C-15 Epimer")
    }
    
    if (length(feats) == 0) return(NULL)
    data.frame(Molecule_Clean = m, Feature = feats, stringsAsFactors = FALSE)
  }) %>%
    bind_rows() %>%
    mutate(Value = 1)
}

sort_phylogenetic_species <- function(sps) {
  ordered <- c()
  if (any(str_detect(tolower(sps), "macranthus")))    ordered <- c(ordered, sps[str_detect(tolower(sps), "macranthus")])
  if (any(str_detect(tolower(sps), "bud")))           ordered <- c(ordered, sps[str_detect(tolower(sps), "bud")])
  if (any(str_detect(tolower(sps), "eichlam")))       ordered <- c(ordered, sps[str_detect(tolower(sps), "eichlam")])
  if (any(str_detect(tolower(sps), "anthesis")))      ordered <- c(ordered, sps[str_detect(tolower(sps), "anthesis")])
  if (any(str_detect(tolower(sps), "flagelliformis")))ordered <- c(ordered, sps[str_detect(tolower(sps), "flagelliformis")])
  others <- setdiff(sps, ordered)
  return(c(ordered, others))
}

# --- MASTER FUNCTION: ANNOTATED SCATTER & STRUCTURAL HEATMAP ---
generate_annotated_heatmap <- function(df_heat, mol_order, species_order, mol_masses, marker_scale = 1.0) {
  p_main <- plot_ly()
  max_z <- max(df_heat$Z_Value, na.rm = TRUE)
  
  df_markers <- df_heat %>%
    filter(!is.na(Z_Value) & Z_Value > 0) %>%
    mutate(
      Molecule_Clean = factor(Molecule_Clean, levels = mol_order),
      Species        = factor(Species,        levels = species_order),
      Marker_Color   = case_when(
        grepl("cyan", tolower(Family)) ~ "rgba(236, 0, 140, 0.85)",
        grepl("xant", tolower(Family)) ~ "rgba(255, 242, 0, 0.85)",
        TRUE                           ~ "rgba(0, 174, 239, 0.85)"
      ),
      Marker_Size = if (max_z > 0) { 4 + (sqrt(Z_Value / max_z) * 26 * marker_scale) } else { 8 }
    )
  
  if (nrow(df_markers) > 0) {
    p_main <- p_main %>% add_trace(
      data = df_markers, x = ~Molecule_Clean, y = ~Species,
      type = "scatter", mode = "markers",
      marker = list(
        size      = ~Marker_Size,
        color     = ~Marker_Color,
        line      = list(color = "#17202A", width = 1), # <-- Borde burbuja a 1
        sizemode  = "diameter"
      ),
      hoverinfo = "text", text = ~Hover_Text, showlegend = FALSE
    )
  }
  
  p_main <- p_main %>%
    layout(
      xaxis = list(
        categoryorder = "array", categoryarray = mol_order,
        tickmode = "array", tickvals = mol_order, ticktext = mol_order,
        title = "", tickangle = -45,
        showline = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1, zeroline = FALSE, # <-- unificado a 1, sin zeroline
        ticks = "outside", tickcolor = "black", tickwidth = 1, ticklen = 5, # <-- unificado a 1
        tickfont = list(family = "Arial", size = 14, color = "black"),
        showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1
      ),
      yaxis = list(
        categoryorder = "array", categoryarray = species_order, autorange = "reversed",
        title = "",
        showline = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1, zeroline = FALSE, # <-- unificado a 1, sin zeroline
        ticks = "outside", tickcolor = "black", tickwidth = 1, ticklen = 5, # <-- unificado a 1
        tickfont = list(family = "Arial", size = 13, color = "black"),
        showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1,
        automargin = TRUE,
        dtick = 1
      ),
      plot_bgcolor = "#ffffff", paper_bgcolor = "#ffffff"
    )
  
  all_feat_levels <- c(
    "Betalamic Acid", "Cyclo-DOPA", "Biogenic Amines",
    "Aromatic AAs", "Polar/Charged AAs", "Aliphatic AAs",
    "Glucose (1)", "Glucose (2)", "Apiose", "Rhamnose", "Glucuronic Acid",
    "Malonic Acid (1)", "Malonic Acid (2)", "HMG Acid",
    "Ferulic Acid (1)", "Ferulic Acid (2)", "p-Coumaric Acid (1)", "p-Coumaric Acid (2)",
    "Sinapic Acid", "Caffeic Acid", "Sulfate Group",
    "-CO2 (1)", "-CO2 (2)", "-CO2 (3)", "-H2", "C-15 Epimer"
  )
  
  struct_df <- get_structural_features(mol_order)
  
  if (is.null(struct_df) || nrow(struct_df) == 0) {
    present_features <- "Betalamic Acid"
    struct_df <- data.frame(Molecule_Clean = mol_order, Feature = "Betalamic Acid", Value = 0)
  } else {
    present_features <- intersect(all_feat_levels, unique(struct_df$Feature))
  }
  
  struct_df$Feature <- factor(struct_df$Feature, levels = present_features)
  struct_df <- struct_df %>%
    complete(
      Molecule_Clean = factor(mol_order, levels = mol_order),
      Feature        = factor(present_features, levels = present_features),
      fill           = list(Value = 0)
    )
  
  p_struct <- plot_ly() %>% add_heatmap(
    data       = struct_df, x = ~Molecule_Clean, y = ~Feature, z = ~Value,
    colorscale = list(c(0, "rgba(255, 255, 255, 0)"), c(1, "#154360")),
    zmin = 0, zmax = 1, showscale = FALSE,
    xgap = 1, ygap = 1, # Separación idéntica al gridwidth
    hoverinfo = "text",
    text = ~paste("<b>", Molecule_Clean, "</b><br>Block:", Feature)
  )
  
  mass_labels     <- sapply(mol_masses, function(m) if (is.na(m)) "-" else as.character(round(m, 1)))
  combined_labels <- paste0(mass_labels, " - ", mol_order)
  
  subplot(p_main, p_struct, nrows = 2, shareX = FALSE, heights = c(0.45, 0.55), margin = 0.12) %>%
    layout(
      plot_bgcolor = "#ffffff", paper_bgcolor = "#ffffff",
      margin = list(b = 320, l = 260, t = 40, r = 60), 
      xaxis2 = list(
        categoryorder = "array", categoryarray = mol_order, matches = "x",
        tickmode = "array", tickvals = mol_order, ticktext = combined_labels,
        title = "", tickangle = -45, 
        showline = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1, zeroline = FALSE, # <-- unificado a 1, sin zeroline
        ticks = "outside", tickcolor = "black", tickwidth = 1, ticklen = 5, # <-- unificado a 1
        tickfont = list(family = "Arial", size = 14, color = "black"), 
        showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1
      ),
      yaxis2 = list(
        title = "", categoryorder = "array", categoryarray = present_features,
        autorange = "reversed",
        tickfont  = list(family = "Arial", size = 13, color = "black"),
        showline  = TRUE, mirror = TRUE, linecolor = "black", linewidth = 1, zeroline = FALSE, # <-- unificado a 1, sin zeroline
        ticks = "outside", tickcolor = "black", tickwidth = 1, ticklen = 5, # <-- unificado a 1
        automargin = TRUE,
        showgrid = TRUE, gridcolor = "#E5E8E8", gridwidth = 1,
        dtick = 1
      )
    ) %>%
    config(displayModeBar = TRUE, toImageButtonOptions = list(format = "svg", filename = "betalains_heatmap"))
}


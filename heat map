server <- function(input, output, session) {
  
  active_species_order <- reactiveVal(character(0))
  
  raw_data <- reactive({
    files <- list.files(PATH_FOLDER, pattern = "\\.csv$", full.names = TRUE)
    if (length(files) == 0) return(NULL)
    files <- files[!basename(files) %in% c("Af.csv", "Disocactus_speciosus.csv")]
    
    list_exp <- lapply(files, function(f) {
      tryCatch({
        df <- read_csv(f, col_types = cols(.default = "c"), show_col_types = FALSE)
        if (ncol(df) < 10) return(NULL)
        colnames(df)[1:10] <- c("Pico","Inicio","RT","Fin","Altura","Area", "Pct_Area","mz","z","Abundancia")
        df$species_name <- basename(f) %>% str_remove("\\.csv$") %>% str_replace_all("_", " ")
        df %>%
          mutate(across(c(mz, Area, RT), ~as.numeric(str_remove_all(., ",")))) %>%
          drop_na(mz, Area)
      }, error = function(e) return(NULL))
    })
    
    if (!file.exists(PATH_TEO)) return(NULL)
    teo_raw <- read_excel(PATH_TEO, sheet = 1, col_types = "text")
    colnames(teo_raw)[1:2] <- c("group", "molecule")
    teo_raw$char_frag <- teo_raw[[3]]
    
    teo <- teo_raw %>%
      pivot_longer(cols = -c(group, molecule, char_frag), names_to = "frag", values_to = "mz_teo") %>%
      mutate(mz_teo = as.numeric(mz_teo), char_frag = as.numeric(char_frag)) %>%
      drop_na(mz_teo)
    
    output$statusMessage <- renderText("System Online")
    list(exp = bind_rows(list_exp), teo = teo)
  })
  
  observe({
    d <- raw_data()
    if (!is.null(d)) {
      ordered_sp <- sort_phylogenetic_species(unique(d$exp$species_name))
      updateCheckboxGroupInput(session, "selected_species", choices = ordered_sp, selected = ordered_sp)
      updateCheckboxGroupInput(session, "selected_groups", choices = unique(d$teo$group), selected = unique(d$teo$group))
    }
  })
  
  observeEvent(input$selected_species, {
    current_order <- active_species_order()
    new_selection <- input$selected_species
    added <- setdiff(new_selection, current_order)
    kept  <- intersect(current_order, new_selection)
    active_species_order(c(kept, added))
  }, ignoreNULL = FALSE)
  
  observeEvent(input$drag_species_order, {
    active_species_order(input$drag_species_order)
  })
  
  output$species_order_ui <- renderUI({
    req(length(active_species_order()) > 0)
    rank_list(
      text = "",
      labels = active_species_order(),
      input_id = "drag_species_order",
      options = sortable_options(animation = 150)
    )
  })
  
  processed_data <- reactive({
    req(input$selected_species, input$selected_groups)
    d <- raw_data()
    if (is.null(d)) return(data.frame())
    
    exp_sub <- d$exp %>%
      filter(species_name %in% input$selected_species, Area >= input$min_area)
    teo_sub <- d$teo %>%
      filter(group %in% input$selected_groups)
    
    fw_table <- tribble(
      ~pattern,          ~weight,
      "macranthus",      27.5,
      "bud",             7.53,
      "eichlam",         11.9,
      "speciosus",       48.0,
      "flagelliformis",  12.2
    )
    
    get_weight <- function(sp_name) {
      sp_lower <- tolower(sp_name)
      for (i in seq_len(nrow(fw_table))) {
        if (grepl(fw_table$pattern[i], sp_lower, fixed = TRUE)) return(fw_table$weight[i])
      }
      return(1)
    }
    
    matches <- vector("list", nrow(exp_sub))
    for (i in seq_len(nrow(exp_sub))) {
      err <- abs(teo_sub$mz_teo - exp_sub$mz[i]) / teo_sub$mz_teo * 1e6
      if (min(err, na.rm = TRUE) <= input$tolerance) {
        hit    <- which.min(err)
        sp_name <- exp_sub$species_name[i]
        weight  <- get_weight(sp_name)
        char_frag_val <- teo_sub$char_frag[hit]
        is_char <- !is.na(char_frag_val) && (abs(teo_sub$mz_teo[hit] - char_frag_val) / char_frag_val * 1e6 <= 10)
        
        matches[[i]] <- data.frame(
          Species      = sp_name,
          Raw_Area     = exp_sub$Area[i],
          Weight_g     = weight,
          Area         = exp_sub$Area[i] / weight,
          Molecule     = teo_sub$molecule[hit],
          Family       = teo_sub$group[hit],
          Mass         = if (!is.na(char_frag_val)) char_frag_val else teo_sub$mz_teo[hit],
          RT           = exp_sub$RT[i],
          Exp_mz       = exp_sub$mz[i],
          Teo_mz       = teo_sub$mz_teo[hit],
          Frag_Type    = teo_sub$frag[hit],
          Error_PPM    = min(err, na.rm = TRUE),
          Is_Char_Frag = is_char
        )
      }
    }
    
    matches <- Filter(Negate(is.null), matches)
    if (length(matches) == 0) return(data.frame())
    
    bind_rows(matches) %>%
      distinct() %>%
      mutate(Molecule_Clean = clean_chem_names(Molecule), Base = purrr::map_chr(Molecule_Clean, classify_base_molecule))
  })
  
  observe({
    df <- processed_data()
    if (!is.null(df) && nrow(df) > 0) {
      mol_choices <- sort(unique(df$Molecule_Clean))
      
      # Mantiene actualizada la lista de checkboxes de moléculas
      updateCheckboxGroupInput(session, "selected_molecules", choices = mol_choices, selected = mol_choices)
      
      sp_choices <- active_species_order() 
      
      # AISLAMIENTO: Previene que el observer se dispare en bucle al interactuar con el dropdown
      current_mol <- isolate(input$ref_molecule)
      current_sp  <- isolate(input$ref_species)
      
      # 1. PARÁMETRO DE INICIO: Molécula (Betanin)
      if (!is.null(current_mol) && nzchar(current_mol) && current_mol %in% mol_choices) {
        selected_mol <- current_mol
      } else {
        selected_mol <- if ("Betanin" %in% mol_choices) "Betanin" else mol_choices[1]
      }
      
      # 2. PARÁMETRO DE INICIO: Especie (Aporocactus flagelliformis)
      target_sp <- "Aporocactus flagelliformis" 
      if (!is.null(current_sp) && nzchar(current_sp) && current_sp %in% sp_choices) {
        selected_sp <- current_sp
      } else {
        selected_sp <- if (target_sp %in% sp_choices) target_sp else if(length(sp_choices) > 0) sp_choices[1] else ""
      }
      
      updateSelectInput(session, "ref_molecule", choices = mol_choices, selected = selected_mol)
      updateSelectInput(session, "ref_species",  choices = sp_choices,  selected = selected_sp)
    }
  })
  
  observeEvent(input$sel_all_mols, {
    df <- processed_data(); req(df)
    updateCheckboxGroupInput(session, "selected_molecules", selected = sort(unique(df$Molecule_Clean)))
  })
  observeEvent(input$desel_all_mols, { updateCheckboxGroupInput(session, "selected_molecules", selected = character(0)) })
  
  observeEvent(input$select_all_sp, {
    d <- raw_data(); req(d)
    updateCheckboxGroupInput(session, "selected_species", selected = sort_phylogenetic_species(unique(d$exp$species_name)))
  })
  observeEvent(input$deselect_all_sp, { updateCheckboxGroupInput(session, "selected_species", selected = character(0)) })
  
  get_base_df <- reactive({
    df <- processed_data()
    req(nrow(df) > 0, input$selected_molecules)
    df <- df %>% filter(Molecule_Clean %in% input$selected_molecules)
    
    df_dedup_initial <- df %>%
      group_by(Molecule_Clean, Family, Species, Base) %>%
      arrange(desc(Is_Char_Frag), desc(Area)) %>%
      slice(1) %>%
      ungroup()
    
    groups_selected <- input$collapse_groups
    if (is.null(groups_selected)) groups_selected <- character(0)
    
    df_dedup_initial <- df_dedup_initial %>%
      mutate(Collapsed_Name = collapse_name(Molecule_Clean, groups_selected))
    
    if (length(groups_selected) > 0) {
      df_final <- df_dedup_initial %>%
        group_by(Collapsed_Name, Family, Species) %>%
        summarise(
          A = sum(Area, na.rm = TRUE),
          Mass = if (any(Molecule_Clean == Collapsed_Name)) Mass[Molecule_Clean == Collapsed_Name][1] else Mass[which.max(Area)],
          .groups = "drop"
        ) %>%
        rename(Molecule_Clean = Collapsed_Name)
    } else {
      df_final <- df_dedup_initial %>%
        rename(A = Area) %>%
        select(Molecule_Clean, Family, Species, A, Mass)
    }
    
    return(df_final)
  })
  
  get_safe_masses <- function(df_heat, mol_order) {
    sapply(mol_order, function(m) {
      val <- df_heat$Mass[df_heat$Molecule_Clean == m]
      if (length(val) > 0 && !all(is.na(val))) val[1] else NA
    })
  }
  
  output$heatmapMassContainer <- renderUI({
    h <- max(950, 500 + length(input$selected_species) * 50)
    plotlyOutput("heatmapMassPlot", height = paste0(h, "px"))
  })
  
  output$heatmapMassPlot <- renderPlotly({
    df_base <- get_base_df(); req(df_base)
    df_heat <- df_base %>%
      group_by(Species) %>%
      mutate(Real_Value = (A / max(A, na.rm = TRUE)) * 100, Z_Value = log10(Real_Value + 1)) %>%
      ungroup() %>%
      arrange(Mass, Molecule_Clean) %>%
      mutate(Hover_Text = paste("<b>", Molecule_Clean, "</b><br>Sp:", Species, "<br>Relative Area (%):", round(Real_Value, 2)))
    
    mol_order     <- unique(df_heat$Molecule_Clean)
    species_order <- intersect(active_species_order(), unique(df_heat$Species)) 
    mol_masses    <- get_safe_masses(df_heat, mol_order)
    
    generate_annotated_heatmap(df_heat, mol_order, species_order, mol_masses, marker_scale = input$marker_visual_scale)
  })
  
  output$heatmapPhylloContainer <- renderUI({
    h <- max(950, 500 + length(input$selected_species) * 50)
    plotlyOutput("heatmapPhylloPlot", height = paste0(h, "px"))
  })
  
  output$heatmapPhylloPlot <- renderPlotly({
    df_base <- get_base_df()
    req(df_base, input$ref_molecule, input$ref_species, input$rel_scale_type)
    ref_row  <- df_base %>% filter(Molecule_Clean == input$ref_molecule, Species == input$ref_species)
    ref_area <- if (nrow(ref_row) > 0) max(ref_row$A, na.rm = TRUE) else max(df_base$A, na.rm = TRUE)
    
    df_heat <- df_base %>%
      mutate(
        Real_Value  = (A / ref_area) * 100,
        Z_Value     = if (input$rel_scale_type == "Logarithmic") log10(Real_Value + 1) else Real_Value,
        Family_Sort = case_when(grepl("xant", tolower(Family)) ~ 1, grepl("cyan", tolower(Family)) ~ 2, TRUE ~ 3)
      ) %>%
      arrange(Family_Sort, Mass, Molecule_Clean) %>%
      mutate(Hover_Text = paste("<b>", Molecule_Clean, "</b><br>Sp:", Species, "<br>Rel. to", input$ref_molecule, "(%):", round(Real_Value, 2)))
    
    mol_order     <- unique(df_heat$Molecule_Clean)
    species_order <- intersect(active_species_order(), unique(df_heat$Species))
    mol_masses    <- get_safe_masses(df_heat, mol_order)
    
    generate_annotated_heatmap(df_heat, mol_order, species_order, mol_masses, marker_scale = input$marker_visual_scale)
  })
  
  output$id_table <- renderDT({
    df <- processed_data()
    req(nrow(df) > 0)
    df <- df %>% filter(Molecule_Clean %in% input$selected_molecules)
    table_out <- df %>%
      select(Species, Family, Molecule_Clean, RT, Exp_mz, Teo_mz, Frag_Type, Is_Char_Frag, Error_PPM, Raw_Area, Area) %>%
      rename(
        `Species / Stage` = Species, `Chemical Family` = Family, `Identified Betalain` = Molecule_Clean,
        `Retention Time (min)` = RT, `Experimental m/z` = Exp_mz, `Theoretical m/z` = Teo_mz,
        `Matched Fragment` = Frag_Type, `Char. Fragment?` = Is_Char_Frag, `Error (PPM)` = Error_PPM,
        `Raw Peak Area` = Raw_Area, `Normalized Area (per g)` = Area
      ) %>%
      arrange(`Species / Stage`, `Retention Time (min)`)
    
    datatable(table_out, options = list(pageLength = 15, scrollX = TRUE), rownames = FALSE, class = "cell-border stripe") %>%
      formatRound(columns = c("Experimental m/z", "Theoretical m/z"), digits = 4) %>%
      formatRound(columns = c("Retention Time (min)", "Error (PPM)"), digits = 2) %>%
      formatSignif(columns = c("Raw Peak Area", "Normalized Area (per g)"), digits = 4)
  })
  
  output$downloadData <- downloadHandler(
    filename = function() paste0("betalains_analysis_supp_data_", Sys.Date(), ".xlsx"),
    content  = function(file) write_xlsx(processed_data(), path = file)
  )
}

shinyApp(ui, server)
